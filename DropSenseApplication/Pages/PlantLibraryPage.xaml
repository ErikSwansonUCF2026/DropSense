<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Views/PlantLibraryPage.xaml                                   -->
<!-- Thin Shell page that hosts PlantLibraryView.                              -->
<!-- BindingContext is NOT set here — PlantLibraryView resolves its own        -->
<!-- PlantLibraryViewModel from DI.  This page stays a dumb host.              -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:DropSense.Views"
             x:Class="DropSense.Views.PlantLibraryPage"
             Shell.NavBarIsVisible="False">

    <views:PlantLibraryView />

</ContentPage>
