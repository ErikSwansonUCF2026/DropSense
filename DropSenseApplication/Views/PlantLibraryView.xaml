<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Views/PlantLibraryView.xaml                                   -->
<!--                                                                            -->
<!-- Layout: single ScrollView column, identical in rhythm to SettingsView.    -->
<!--                                                                            -->
<!--   [Banner area]                                                            -->
<!--   [+ Add Plant accordion — expands inline]                                 -->
<!--   [LIBRARY section header]                                                 -->
<!--   [Plant list — each entry: name row + expand → threshold editor]          -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:DropSense.ViewModels" xmlns:conv="clr-namespace:DropSense.Converters" x:Class="DropSense.Views.PlantLibraryView" x:DataType="vm:PlantLibraryViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />

            <!-- ── Threshold numeric entry — narrow centred input ─────────── -->
            <Style x:Key="ThresholdEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Keyboard" Value="Numeric" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Placeholder" Value="—" />
            </Style>

            <!-- ── Column header micro-label ─────────────────────────────── -->
            <Style x:Key="ColHeader" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <!-- ── Inline entry border wrapper ───────────────────────────── -->
            <Style x:Key="EntryBorder" TargetType="Border">
                <Setter Property="Stroke" Value="{StaticResource Border}" />
                <Setter Property="StrokeThickness" Value="0.5" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="0">

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  Status banners — same pattern as SettingsView             -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" BackgroundColor="{StaticResource GreenBg}" Stroke="{StaticResource Green}" Margin="0,0,0,8" IsVisible="{Binding ShowSuccessBanner}">
                <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Green}" FontSize="13" />
            </Border>

            <Border Style="{StaticResource CardStyle}" BackgroundColor="{StaticResource RedBg}" Stroke="{StaticResource Red}" Margin="0,0,0,8" IsVisible="{Binding ShowErrorBanner}">
                <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Red}" FontSize="13" />
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  ADD PLANT — expandable accordion card                     -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Label Text="Actions" Style="{StaticResource SectionHeader}" />

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                <VerticalStackLayout Spacing="0">

                    <!-- Accordion header — always visible tap target -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Add Plant" Style="{StaticResource InputLabel}" FontAttributes="Bold" />
                            <Label Text="Register a new plant and configure its thresholds" FontSize="11" TextColor="{StaticResource TextMuted}" />
                        </VerticalStackLayout>

                        <!-- Chevron button toggles the form -->
                        <Button Grid.Column="1" x:Name="AddPlantChevron" Text="＋" Style="{StaticResource SecondaryButton}" WidthRequest="40" HeightRequest="36" Padding="0" Clicked="OnAddPlantToggled" ToolTipProperties.Text="Expand / collapse" />
                    </Grid>

                    <!-- Accordion body — collapsed by default -->
                    <VerticalStackLayout x:Name="AddPlantForm" Spacing="8" IsVisible="False" Margin="0,12,0,0">

                        <!-- Divider -->
                        <BoxView HeightRequest="0.5" BackgroundColor="{StaticResource Border}" Margin="0,0,0,8" />

                        <Label Text="Common Name *" Style="{StaticResource InputLabel}" />
                        <Border Style="{StaticResource EntryBorder}">
                            <Entry Text="{Binding NewCommonName}" Placeholder="e.g. Tomato" MaxLength="50" BackgroundColor="Transparent" FontSize="13" />
                        </Border>

                        <Label Text="Scientific Name" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                        <Border Style="{StaticResource EntryBorder}">
                            <Entry Text="{Binding NewScientificName}" Placeholder="e.g. Solanum lycopersicum" MaxLength="50" BackgroundColor="Transparent" FontSize="13" />
                        </Border>

                        <Label Text="Notes" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                        <Border Style="{StaticResource EntryBorder}">
                            <Editor Text="{Binding NewNotes}" Placeholder="Optional growing notes…" AutoSize="TextChanges" FontSize="13" BackgroundColor="Transparent" MinimumHeightRequest="52" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <Button Grid.Column="0" Text="Cancel" Style="{StaticResource SecondaryButton}" HeightRequest="40" Clicked="OnAddPlantToggled" />
                            <Button Grid.Column="1" Text="Add to Library" Style="{StaticResource PrimaryButton}" HeightRequest="40" Command="{Binding AddPlantCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        </Grid>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ══════════════════════════════════════════════════════════ -->
            <!--  LIBRARY — plant list                                       -->
            <!-- ══════════════════════════════════════════════════════════ -->
            <Label Text="Library" Style="{StaticResource SectionHeader}" />

            <!-- Empty state -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" IsVisible="{Binding HasNoPlants}">
                <Label Text="No plants registered yet. Use the Add Plant panel above." FontSize="13" TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" />
            </Border>

            <!-- ── Plant list (BindableLayout over VerticalStackLayout) ─── -->
            <!-- x:DataType stays on PlantLibraryViewModel; items are        -->
            <!-- PlantEntryViewModel wrappers so we never set DataType to    -->
            <!-- the raw Plant model directly in a nested template.          -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlantEntries}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlantEntryViewModel">

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">

                            <!-- ── Row highlight when expanded ───────────── -->
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource BlueLight}" />
                                    <Setter Property="Stroke" Value="{StaticResource Blue}" />
                                </DataTrigger>
                            </Border.Triggers>

                            <VerticalStackLayout Spacing="0">

                                <!-- ── Plant header row ───────────────────── -->
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                                    <!-- Name + scientific + threshold count -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Plant.CommonName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Plant.ScientificName}" FontSize="11" FontAttributes="Italic" TextColor="{StaticResource TextMuted}" IsVisible="{Binding Plant.ScientificName, Converter={StaticResource BoolToVis}}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Channel count badge -->
                                    <Border Grid.Column="1" BackgroundColor="{StaticResource GreenBg}" Stroke="{StaticResource Green}" StrokeThickness="0.5" Padding="6,2" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Plant.storedThresholds.Count, StringFormat='{0} ch'}" FontSize="10" TextColor="{StaticResource Green}" />
                                    </Border>

                                    <!-- Delete -->
                                    <Button Grid.Column="2" Text="✕" Style="{StaticResource WarningButton}" WidthRequest="36" HeightRequest="36" Padding="0" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.DeletePlantCommand}" CommandParameter="{Binding .}" ToolTipProperties.Text="Delete plant" />

                                    <!-- Expand / collapse -->
                                    <Button Grid.Column="3" Text="{Binding ExpandChevron}" Style="{StaticResource SecondaryButton}" WidthRequest="36" HeightRequest="36" Padding="0" Command="{Binding ToggleExpandCommand}" ToolTipProperties.Text="Edit thresholds" />
                                </Grid>

                                <!-- ── Edit plant fields (visible when editing) ─ -->
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsEditingDetails}" Margin="0,12,0,0">

                                    <BoxView HeightRequest="0.5" BackgroundColor="{StaticResource Border}" Margin="0,0,0,4" />

                                    <Label Text="Edit Plant Details" Style="{StaticResource SectionHeader}" Margin="0,0,0,0" />

                                    <Label Text="Common Name *" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource EntryBorder}">
                                        <Entry Text="{Binding EditCommonName}" MaxLength="50" BackgroundColor="Transparent" FontSize="13" />
                                    </Border>

                                    <Label Text="Scientific Name" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                                    <Border Style="{StaticResource EntryBorder}">
                                        <Entry Text="{Binding EditScientificName}" MaxLength="50" BackgroundColor="Transparent" FontSize="13" />
                                    </Border>

                                    <Label Text="Notes" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                                    <Border Style="{StaticResource EntryBorder}">
                                        <Editor Text="{Binding EditNotes}" AutoSize="TextChanges" FontSize="13" BackgroundColor="Transparent" MinimumHeightRequest="44" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                        <Button Grid.Column="0" Text="Cancel" Style="{StaticResource SecondaryButton}" HeightRequest="40" Command="{Binding CancelEditDetailsCommand}" />
                                        <Button Grid.Column="1" Text="Save" Style="{StaticResource PrimaryButton}" HeightRequest="40" Command="{Binding SaveEditDetailsCommand}" />
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- ── Threshold editor (visible when expanded) ── -->
                                <VerticalStackLayout Spacing="0" IsVisible="{Binding IsExpanded}" Margin="0,12,0,0">

                                    <BoxView HeightRequest="0.5" BackgroundColor="{StaticResource Border}" Margin="0,0,0,8" />

                                    <!-- Notes (read-only) + edit button -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8" IsVisible="{Binding HasNotes}">
                                        <Label Grid.Column="0" Text="{Binding Plant.Notes}" FontSize="12" TextColor="{StaticResource TextMuted}" LineBreakMode="WordWrap" />
                                        <Button Grid.Column="1" Text="Edit" Style="{StaticResource SecondaryButton}" WidthRequest="52" HeightRequest="32" Padding="0" FontSize="12" Command="{Binding BeginEditDetailsCommand}" />
                                    </Grid>

                                    <!-- Edit button when no notes -->
                                    <Button Text="Edit Plant Details" Style="{StaticResource SecondaryButton}" HeightRequest="36" Margin="0,0,0,8" FontSize="12" Command="{Binding BeginEditDetailsCommand}" IsVisible="{Binding HasNotes, Converter={StaticResource InverseBool}}" />

                                    <!-- Threshold section label -->
                                    <Label Text="Sensor Thresholds" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                                    <Label Text="Leave a field blank to leave that bound unconstrained. Clear all values to remove the threshold." FontSize="11" TextColor="{StaticResource TextMuted}" LineBreakMode="WordWrap" Margin="0,0,0,10" />

                                    <!-- Column headers -->
                                    <Grid ColumnDefinitions="*,78,78,78,78" ColumnSpacing="4" Padding="0,0,0,4">
                                        <Label Grid.Column="0" Text="Channel" Style="{StaticResource ColHeader}" HorizontalTextAlignment="Start" />
                                        <Label Grid.Column="1" Text="Ideal Min" Style="{StaticResource ColHeader}" />
                                        <Label Grid.Column="2" Text="Ideal Max" Style="{StaticResource ColHeader}" />
                                        <Label Grid.Column="3" Text="Safe Min" Style="{StaticResource ColHeader}" />
                                        <Label Grid.Column="4" Text="Safe Max" Style="{StaticResource ColHeader}" />
                                    </Grid>

                                    <!-- Threshold rows -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ThresholdRows}" Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThresholdEditorRow">

                                                <Border Stroke="{StaticResource Border}" StrokeThickness="0.5" Padding="10,8" BackgroundColor="{StaticResource Surface2}">

                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>

                                                    <!-- Green tint when row has saved data -->
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource GreenBg}" />
                                                            <Setter Property="Stroke" Value="{StaticResource Green}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>

                                                    <Grid ColumnDefinitions="*,78,78,78,78" ColumnSpacing="4">

                                                        <!-- Channel name + unit -->
                                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                            <Label Text="{Binding Label}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                                            <Label Text="{Binding Unit}" FontSize="10" TextColor="{StaticResource TextMuted}" />
                                                        </VerticalStackLayout>

                                                        <!-- Ideal Min -->
                                                        <Border Grid.Column="1" Style="{StaticResource EntryBorder}">
                                                            <Entry Style="{StaticResource ThresholdEntry}" Text="{Binding IdealMinText}" />
                                                        </Border>

                                                        <!-- Ideal Max -->
                                                        <Border Grid.Column="2" Style="{StaticResource EntryBorder}">
                                                            <Entry Style="{StaticResource ThresholdEntry}" Text="{Binding IdealMaxText}" />
                                                        </Border>

                                                        <!-- Safe Min -->
                                                        <Border Grid.Column="3" Style="{StaticResource EntryBorder}">
                                                            <Entry Style="{StaticResource ThresholdEntry}" Text="{Binding SafeMinText}" />
                                                        </Border>

                                                        <!-- Safe Max -->
                                                        <Border Grid.Column="4" Style="{StaticResource EntryBorder}">
                                                            <Entry Style="{StaticResource ThresholdEntry}" Text="{Binding SafeMaxText}" />
                                                        </Border>

                                                    </Grid>
                                                </Border>

                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <!-- Save thresholds -->
                                    <Button Text="Save Thresholds" Style="{StaticResource PrimaryButton}" HeightRequest="44" Margin="0,12,0,0" Command="{Binding SaveThresholdsCommand}" IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.IsBusy, Converter={StaticResource InverseBool}}" />

                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Margin="0,8,0,0" Color="{StaticResource Blue}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
