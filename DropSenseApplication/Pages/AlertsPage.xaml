<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Pages/AlertsPage.xaml                                         -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- Routable Shell page. Thin host for AlertsPanel.                          -->
<!-- Route: Routing.RegisterRoute(nameof(AlertsPage), typeof(AlertsPage));    -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:DropSense.Views" x:Class="DropSense.Views.AlertsPage" Title="Received Alerts" Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="260,1,*" RowDefinitions="Auto,*">

        <!-- Sidebar -->
        <views:SidebarView 
            Grid.Column="0" 
            Grid.RowSpan="2" />

        <!-- Divider -->
        <BoxView Grid.Column="1"
                 Grid.RowSpan="2" 
                 WidthRequest="1" 
                 BackgroundColor="{StaticResource Border}" />

        <!-- Header -->
        <Border Grid.Column="2"
                Grid.Row="0" 
                ZIndex="10" 
                BackgroundColor="{StaticResource White}" 
                StrokeThickness="0" 
                Padding="16,12">

            <Border.Shadow>
                <Shadow Brush="{StaticResource TextPrimary}" 
                        Offset="0,1" 
                        Radius="4" 
                        Opacity="0.4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="2">

                <Label Text="Received Alerts" 
                       FontSize="18" 
                       FontAttributes="Bold" 
                       TextColor="{StaticResource BlueDark}" />

                <Label Text="View and manage device alerts" 
                       FontSize="12" 
                       TextColor="{StaticResource TextPrimary}" />

            </VerticalStackLayout>
        </Border>

        <!-- Main Content -->
        <views:AlertsPanel Grid.Column="2" Grid.Row="1" />

    </Grid>

</ContentPage>