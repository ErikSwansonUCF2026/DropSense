<?xml version = "1.0" encoding = "UTF-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DropSense.Views"
    x:Class="DropSense.AppShell" 

    TitleColor="Black"
    NavBarHasShadow="False">
        


    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate views:DashboardPage}" />

    
    <ShellContent
        Title="Alerts"
        ContentTemplate="{DataTemplate views:AlertsPage}"
        Route="AlertsPage" />


    <ShellContent 
        Title="Settings" 
        ContentTemplate="{DataTemplate views:SettingsPage}" 
        Route="DeviceSettingsPage" />

    <ShellContent
        Title="Analysis and Export"
        ContentTemplate="{DataTemplate views:AnalysisExportPage}"
        Route="AnalysisExportPage" />
    
    <ShellContent
        Title="Plant Library"
        ContentTemplate="{DataTemplate views:PlantLibraryPage}"
        Route="PlantLibraryPage" />

</Shell>