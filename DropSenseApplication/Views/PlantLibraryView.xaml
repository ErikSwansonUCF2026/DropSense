<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Views/PlantLibraryView.xaml                                   -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DropSense.ViewModels"
             xmlns:conv="clr-namespace:DropSense.Converters"
             x:Class="DropSense.Views.PlantLibraryView"
             x:DataType="vm:PlantLibraryViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter      x:Key="InverseBool" />

            <!-- ── New colours specific to the Plant Library ────────────────── -->
            <!-- GreenAccent: used for "has thresholds" dot and action accents   -->
            <Color x:Key="GreenAccent">#1A7A4A</Color>
            <Color x:Key="GreenAccentBg">#E8F5EE</Color>
            <Color x:Key="SelectedCardBg">#EEF4FC</Color>
            <Color x:Key="SelectedCardStroke">#1A6FC4</Color>

            <!-- ── PlantListCard — slightly tighter than CardStyle ───────────── -->
            <Style x:Key="PlantListCard" TargetType="Border">
                <Setter Property="BackgroundColor"  Value="{StaticResource Surface}" />
                <Setter Property="Stroke"           Value="{StaticResource Border}" />
                <Setter Property="StrokeThickness"  Value="1" />
                <Setter Property="Padding"          Value="12,10" />
                <Setter Property="Margin"           Value="0,0,0,6" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ThresholdRowCard — compact row inside the editor panel ────── -->
            <Style x:Key="ThresholdRowCard" TargetType="Border">
                <Setter Property="BackgroundColor"  Value="{StaticResource Surface2}" />
                <Setter Property="Stroke"           Value="{StaticResource Border}" />
                <Setter Property="StrokeThickness"  Value="0.5" />
                <Setter Property="Padding"          Value="10,8" />
                <Setter Property="Margin"           Value="0,0,0,4" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="8" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── ThresholdEntry — narrow numeric entry ─────────────────────── -->
            <Style x:Key="ThresholdEntry" TargetType="Entry">
                <Setter Property="FontSize"                Value="12" />
                <Setter Property="Keyboard"                Value="Numeric" />
                <Setter Property="WidthRequest"            Value="72" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="BackgroundColor"         Value="Transparent" />
                <Setter Property="Placeholder"             Value="—" />
            </Style>

            <!-- ── SmallLabel — column header inside threshold rows ───────────── -->
            <Style x:Key="SmallLabel" TargetType="Label">
                <Setter Property="FontSize"             Value="10" />
                <Setter Property="TextColor"            Value="{StaticResource TextMuted}" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <!-- ── IconButton — borderless icon-sized tap target ─────────────── -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor"       Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize"        Value="14" />
                <Setter Property="Padding"         Value="4" />
                <Setter Property="BorderWidth"     Value="0" />
                <Setter Property="CornerRadius"    Value="6" />
                <Setter Property="HeightRequest"   Value="32" />
                <Setter Property="WidthRequest"    Value="32" />
            </Style>

            <!-- ── DangerIconButton ───────────────────────────────────────────── -->
            <Style x:Key="DangerIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="TextColor" Value="{StaticResource Red}" />
            </Style>

        </ResourceDictionary>
    </ContentView.Resources>

    <!-- ════════════════════════════════════════════════════════════════════════
         Root: outer Grid splits the view into a LEFT plant list and a RIGHT
         detail/editor panel.  On narrow screens both collapse to a single column
         and the detail panel is hidden until a plant is selected.
         ════════════════════════════════════════════════════════════════════════ -->
    <Grid x:Name="RootGrid" ColumnDefinitions="320,*" ColumnSpacing="0"
          BackgroundColor="{StaticResource Bg}">

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  LEFT COLUMN — Plant List                                          -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Column="0" BackgroundColor="{StaticResource Bg}">
            <VerticalStackLayout Padding="16,16,12,32" Spacing="0">

                <!-- Page title -->
                <Label Text="Plant Library" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                <Label Text="Define plants and their sensor thresholds for alert evaluation."
                       FontSize="12" TextColor="{StaticResource TextMuted}"
                       LineBreakMode="WordWrap" Margin="0,0,0,16" />

                <!-- ── Status banners ──────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        BackgroundColor="{StaticResource GreenBg}"
                        Stroke="{StaticResource GreenAccent}"
                        Margin="0,0,0,8"
                        IsVisible="{Binding ShowSuccessBanner}">
                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource GreenAccent}" FontSize="13" />
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        BackgroundColor="{StaticResource RedBg}"
                        Stroke="{StaticResource Red}"
                        Margin="0,0,0,8"
                        IsVisible="{Binding ShowErrorBanner}">
                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource Red}" FontSize="13" />
                </Border>

                <!-- ── Section: Add New Plant ──────────────────────────────── -->
                <Label Text="Add Plant" Style="{StaticResource SectionHeader}" />

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="8">

                        <Label Text="Common Name *" Style="{StaticResource InputLabel}" />
                        <Entry Text="{Binding NewCommonName}"
                               Placeholder="e.g. Tomato"
                               MaxLength="50"
                               BackgroundColor="Transparent" FontSize="13" />

                        <Label Text="Scientific Name" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                        <Entry Text="{Binding NewScientificName}"
                               Placeholder="e.g. Solanum lycopersicum"
                               MaxLength="50"
                               BackgroundColor="Transparent" FontSize="13" />

                        <Label Text="Notes" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                        <Editor Text="{Binding NewNotes}"
                                Placeholder="Optional growing notes…"
                                AutoSize="TextChanges"
                                FontSize="13"
                                BackgroundColor="Transparent"
                                MinimumHeightRequest="52" />

                        <Button Text="Add to Library"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="40"
                                Margin="0,4,0,0"
                                Command="{Binding AddPlantCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Section: Library entries ───────────────────────────── -->
                <Label Text="Library" Style="{StaticResource SectionHeader}" />

                <!-- Empty state -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6"
                        IsVisible="{Binding Plants.Count, Converter={StaticResource InverseBool}}">
                    <Label Text="No plants yet. Add one above."
                           FontSize="13" TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Plants}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:Plant">

                            <Border x:Name="PlantCard" Style="{StaticResource PlantListCard}">

                                <!-- Visual trigger: highlight selected card -->
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SelectedCardBg}" />
                                        <Setter Property="Stroke"          Value="{StaticResource SelectedCardStroke}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                                      RowDefinitions="Auto,Auto">

                                    <!-- Common + scientific name -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0"
                                                        Grid.RowSpan="2"
                                                        VerticalOptions="Center">
                                        <Label Text="{Binding CommonName}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding ScientificName}"
                                               FontSize="11" FontAttributes="Italic"
                                               TextColor="{StaticResource TextMuted}"
                                               IsVisible="{Binding ScientificName, Converter={StaticResource BoolToVis}}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Threshold count badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            BackgroundColor="{StaticResource GreenAccentBg}"
                                            Stroke="{StaticResource GreenAccent}"
                                            StrokeThickness="0.5"
                                            Padding="6,2"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="4" />
                                        </Border.StrokeShape>
                                        <Label FontSize="10" TextColor="{StaticResource GreenAccent}"
                                               Text="{Binding Thresholds.Count, StringFormat='{0} ch'}" />
                                    </Border>

                                    <!-- Select / Delete -->
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="2"
                                                          Grid.RowSpan="2"
                                                          VerticalOptions="Center"
                                                          Spacing="2">

                                        <Button Text="✎"
                                                Style="{StaticResource IconButton}"
                                                TextColor="{StaticResource Blue}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.SelectPlantCommand}"
                                                CommandParameter="{Binding .}"
                                                ToolTipProperties.Text="Edit thresholds" />

                                        <Button Text="✕"
                                                Style="{StaticResource DangerIconButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.DeletePlantCommand}"
                                                CommandParameter="{Binding .}"
                                                ToolTipProperties.Text="Delete plant" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center"
                                   Margin="0,8,0,0"
                                   Color="{StaticResource Blue}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  RIGHT COLUMN — Detail / Threshold Editor                          -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Border}"
                StrokeThickness="1"
                StrokeShape="Rectangle"
                Padding="0">

            <!-- Empty state: no plant selected -->
            <Grid>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     IsVisible="{Binding IsPlantSelected, Converter={StaticResource InverseBool}}">
                    <Label Text="🌿" FontSize="40" HorizontalTextAlignment="Center" />
                    <Label Text="Select a plant from the list to view and edit its thresholds."
                           FontSize="13" TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" MaximumWidthRequest="240"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Detail panel: plant selected -->
                <ScrollView IsVisible="{Binding IsPlantSelected}">
                    <VerticalStackLayout Padding="20,16,20,32" Spacing="0">

                        <!-- ── Plant header ──────────────────────────────────── -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
                              Margin="0,0,0,4">

                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding SelectedPlant.CommonName}"
                                       FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding SelectedPlant.ScientificName}"
                                       FontSize="12" FontAttributes="Italic"
                                       TextColor="{StaticResource TextMuted}"
                                       IsVisible="{Binding SelectedPlant.ScientificName, Converter={StaticResource BoolToVis}}" />
                            </VerticalStackLayout>

                            <!-- Edit / Close buttons -->
                            <Button Grid.Column="1"
                                    Text="Edit"
                                    Style="{StaticResource SecondaryButton}"
                                    WidthRequest="60"
                                    Command="{Binding BeginEditPlantCommand}"
                                    IsVisible="{Binding IsEditingPlant, Converter={StaticResource InverseBool}}" />

                            <Button Grid.Column="1"
                                    Text="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    WidthRequest="70"
                                    Command="{Binding CancelEditPlantCommand}"
                                    IsVisible="{Binding IsEditingPlant}" />

                        </Grid>

                        <!-- Notes preview -->
                        <Label Text="{Binding SelectedPlant.Notes}"
                               FontSize="12" TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap"
                               Margin="0,0,0,12"
                               IsVisible="{Binding SelectedPlant.Notes, Converter={StaticResource BoolToVis}}" />

                        <!-- ── Inline plant editor ───────────────────────────── -->
                        <Border Style="{StaticResource CardStyle}"
                                BackgroundColor="{StaticResource BlueLight}"
                                Stroke="{StaticResource Blue}"
                                Margin="0,0,0,16"
                                IsVisible="{Binding IsEditingPlant}">
                            <VerticalStackLayout Spacing="8">

                                <Label Text="Edit Plant Details" Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,4" />

                                <Label Text="Common Name *" Style="{StaticResource InputLabel}" />
                                <Entry Text="{Binding EditCommonName}"
                                       MaxLength="50"
                                       BackgroundColor="Transparent" FontSize="13" />

                                <Label Text="Scientific Name" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                                <Entry Text="{Binding EditScientificName}"
                                       MaxLength="50"
                                       BackgroundColor="Transparent" FontSize="13" />

                                <Label Text="Notes" Style="{StaticResource InputLabel}" Margin="0,4,0,0" />
                                <Editor Text="{Binding EditNotes}"
                                        AutoSize="TextChanges"
                                        FontSize="13"
                                        BackgroundColor="Transparent"
                                        MinimumHeightRequest="52" />

                                <Button Text="Save Changes"
                                        Style="{StaticResource PrimaryButton}"
                                        HeightRequest="40"
                                        Margin="0,4,0,0"
                                        Command="{Binding SaveEditPlantCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- ── Threshold editor ──────────────────────────────── -->
                        <Label Text="Sensor Thresholds" Style="{StaticResource SectionHeader}" />
                        <Label Text="Leave any field blank to leave that bound unconstrained. Clear all values to remove the threshold entirely."
                               FontSize="12" TextColor="{StaticResource TextMuted}"
                               LineBreakMode="WordWrap" Margin="0,0,0,10" />

                        <!-- Column headers row -->
                        <Grid ColumnDefinitions="*,72,72,72,72,32" ColumnSpacing="4"
                              Margin="0,0,0,4" Padding="10,0">
                            <Label Grid.Column="0" Text="Channel"    Style="{StaticResource SmallLabel}" HorizontalTextAlignment="Start" />
                            <Label Grid.Column="1" Text="Ideal Min"  Style="{StaticResource SmallLabel}" />
                            <Label Grid.Column="2" Text="Ideal Max"  Style="{StaticResource SmallLabel}" />
                            <Label Grid.Column="3" Text="Safe Min"   Style="{StaticResource SmallLabel}" />
                            <Label Grid.Column="4" Text="Safe Max"   Style="{StaticResource SmallLabel}" />
                        </Grid>

                        <!-- Threshold rows -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ThresholdRows}" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThresholdEditorRow">

                                    <Border Style="{StaticResource ThresholdRowCard}">

                                        <!-- Highlight row when it has saved data -->
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsEnabled}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource GreenAccentBg}" />
                                                <Setter Property="Stroke"          Value="{StaticResource GreenAccent}" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Grid ColumnDefinitions="*,72,72,72,72,32"
                                              ColumnSpacing="4">

                                            <!-- Channel name + unit -->
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                <Label Text="{Binding Label}"
                                                       FontSize="12" FontAttributes="Bold"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding Unit}"
                                                       FontSize="10"
                                                       TextColor="{StaticResource TextMuted}" />
                                            </VerticalStackLayout>

                                            <!-- Four numeric inputs -->
                                            <Border Grid.Column="1"
                                                    Stroke="{StaticResource Border}"
                                                    StrokeThickness="0.5" Padding="4,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry Style="{StaticResource ThresholdEntry}"
                                                       Text="{Binding IdealMinText}" />
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Stroke="{StaticResource Border}"
                                                    StrokeThickness="0.5" Padding="4,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry Style="{StaticResource ThresholdEntry}"
                                                       Text="{Binding IdealMaxText}" />
                                            </Border>

                                            <Border Grid.Column="3"
                                                    Stroke="{StaticResource Border}"
                                                    StrokeThickness="0.5" Padding="4,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry Style="{StaticResource ThresholdEntry}"
                                                       Text="{Binding SafeMinText}" />
                                            </Border>

                                            <Border Grid.Column="4"
                                                    Stroke="{StaticResource Border}"
                                                    StrokeThickness="0.5" Padding="4,2">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="5" />
                                                </Border.StrokeShape>
                                                <Entry Style="{StaticResource ThresholdEntry}"
                                                       Text="{Binding SafeMaxText}" />
                                            </Border>

                                            <!-- Clear individual row -->
                                            <Button Grid.Column="5"
                                                    Text="✕"
                                                    Style="{StaticResource DangerIconButton}"
                                                    IsVisible="{Binding IsEnabled}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.DeleteThresholdCommand}"
                                                    CommandParameter="{Binding .}"
                                                    ToolTipProperties.Text="Clear this threshold" />
                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Save thresholds -->
                        <Button Text="Save Thresholds"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="44"
                                Margin="0,16,0,0"
                                Command="{Binding SaveThresholdsCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

    </Grid>
</ContentView>
