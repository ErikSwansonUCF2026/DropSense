<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Views/AlertsPanel.xaml                                        -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- ADD TO PROJECT: Step 6                                                    -->
<!-- ContentView that hosts the alert list, toolbar, and the detail modal     -->
<!-- overlay. Hosted inside AlertsPage.                                       -->
<!-- BindingContext = AlertsViewModel (set in AlertsPanel.xaml.cs via DI).    -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DropSense.ViewModels"
    xmlns:model="clr-namespace:DropSense.Models"
    xmlns:conv="clr-namespace:DropSense.Converters"
    x:Class="DropSense.Views.AlertsPanel"
    x:DataType="vm:AlertsViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter      x:Key="InverseBool" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- Root Grid — panel layer + modal overlay layer -->
    <Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  LAYER 0 — Alert panel                                             -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- ── Toolbar row ──────────────────────────────────────────────── -->
            <Grid Grid.Row="0"
                 ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
                 ColumnSpacing="8"
                 Padding="16,12">

                <!-- Badge + heading -->
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="Alerts"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center" />

                    <!-- Unacknowledged badge — hidden when count is 0 -->
                    <Border
                        BackgroundColor="{StaticResource Red}"
                        Padding="6,2"
                        IsVisible="{Binding HasUnacknowledged}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding BadgeText}"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="White" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Auto-save toggle button -->
                <Button Grid.Column="1"
                        Text="{Binding AutoSaveLabel}"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="36" Padding="10,0"
                        Command="{Binding ToggleAutoSaveCommand}" />

                <!-- Save all unsaved -->
                <Button Grid.Column="2"
                        Text="Save All"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="36" Padding="10,0"
                        Command="{Binding SaveAllUnsavedCommand}" />

                <!-- Clear all -->
                <Button Grid.Column="3"
                        Text="Clear All"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="36" Padding="10,0"
                        TextColor="{StaticResource Red}"
                        BorderColor="{StaticResource Red}"
                        Command="{Binding ClearAllCommand}" />

                <!-- Restore alerts from CSV -->
                <Button Grid.Column="4"
                    Text="Restore"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="36"
                    Padding="10,0"
                    Command="{Binding RestoreAlertsCommand}" />
                <!-- Open logs folder (Windows only) -->
                <Button Grid.Column="5"
                    Text="Open Logs"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="36"
                    Padding="10,0"
                    Command="{Binding OpenLogsFolderCommand}" />
            </Grid>

            <!-- ── Status message ───────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    BackgroundColor="{StaticResource GreenBg}"
                    Stroke="{StaticResource Green}"
                    Margin="16,0,16,8"
                    IsVisible="{Binding HasStatus}">
                <Label Text="{Binding StatusMessage}"
                       TextColor="{StaticResource Green}"
                       FontSize="12" />
            </Border>

            <!-- ── Alert list ────────────────────────────────────────────────── -->
            <!-- Empty state -->
            <VerticalStackLayout
                Grid.Row="2"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Spacing="8"
                IsVisible="{Binding HasAlerts, Converter={StaticResource InverseBool}}">
                <Label Text="No alerts"
                       FontSize="32"
                       HorizontalTextAlignment="Center" />
                <Label Text="The device will push alerts here when a threshold is exceeded."
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       MaximumWidthRequest="280" />
            </VerticalStackLayout>

            <!-- Alert rows -->
            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding Alerts}"
                Margin="12,0"
                IsVisible="{Binding HasAlerts}">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:AlertEvent">
                        <SwipeView>

                            <!-- Swipe-to-clear (right → left) -->
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Clear"
                                               BackgroundColor="{StaticResource Red}"
                                               IconImageSource="trash.png"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, Path=ClearSingleCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!-- Row card -->
                            <Border Style="{StaticResource CardStyle}"
                                    Margin="4,4"
                                    Padding="14,10">
                                <Grid ColumnDefinitions="6,*,Auto" ColumnSpacing="10">

                                    <!-- Severity stripe -->
                                    <BoxView Grid.Column="0"
                                             WidthRequest="4"
                                             CornerRadius="2"
                                             Color="{Binding SeverityColor}"
                                             VerticalOptions="Fill" />

                                    <!-- Main content -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding ChannelDisplay}"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}" />
                                            <Border BackgroundColor="{Binding SeverityColor}"
                                                    Padding="5,1">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding SeverityDisplay}"
                                                       FontSize="10" TextColor="White"
                                                       FontAttributes="Bold" />
                                            </Border>
                                            <!-- Dismissed indicator -->
                                            <Label Text="Dismissed"
                                                   FontSize="10" FontAttributes="Italic"
                                                   TextColor="{StaticResource TextMuted}"
                                                   IsVisible="{Binding IsDismissed}" />
                                            <!-- Saved indicator -->
                                            <Label Text="✓ Saved"
                                                   FontSize="10"
                                                   TextColor="{StaticResource Green}"
                                                   IsVisible="{Binding IsSaved}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Summary}"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding TimestampShort}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextMuted}" />
                                    </VerticalStackLayout>

                                    <!-- Detail arrow / tap target -->
                                    <Button Grid.Column="2"
                                            Text="›"
                                            FontSize="20"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextMuted}"
                                            BorderWidth="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AlertsViewModel}}, Path=OpenAlertCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>

                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- ── Bottom spacer ─────────────────────────────────────────────── -->
            <BoxView Grid.Row="3" HeightRequest="16" Color="Transparent" />
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!--  LAYER 1 — Modal overlay (shown when IsModalOpen = True)           -->
        <!-- ══════════════════════════════════════════════════════════════════ -->

        <!-- Scrim -->
        <BoxView
            Color="#80000000"
            IsVisible="{Binding IsModalOpen}">
            <BoxView.GestureRecognizers>
                <!-- Tap scrim to close -->
                <TapGestureRecognizer Command="{Binding CloseModalCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Modal card — centred over the panel -->
        <Border
            Style="{StaticResource CardStyle}"
            Padding="24"
            MinimumWidthRequest="300"
            MaximumWidthRequest="800"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Margin="20"
            IsVisible="{Binding IsModalOpen}">

            <VerticalStackLayout Spacing="16" x:DataType="vm:AlertsViewModel">

                <!-- Modal header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Alert Detail"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           VerticalTextAlignment="Center" />
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="16"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource TextMuted}"
                            BorderWidth="0"
                            WidthRequest="36" HeightRequest="36"
                            Command="{Binding CloseModalCommand}" />
                </Grid>

                <!-- Severity bar -->
                <Border
                    BackgroundColor="{Binding SelectedAlert.SeverityColor}"
                    Padding="10,6">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Label Text="{Binding SelectedAlert.SeverityDisplay}"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                </Border>

                <!-- Detail fields grid -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="8"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                    <Label Grid.Row="0" Grid.Column="0" Text="Channel"      Style="{StaticResource UnitLabel}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAlert.ChannelDisplay}"
                           FontSize="13" TextColor="{StaticResource TextPrimary}" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Value"        Style="{StaticResource UnitLabel}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAlert.ValueDisplay}"
                           FontSize="13" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Condition"    Style="{StaticResource UnitLabel}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAlert.ConditionDisplay}"
                           FontSize="13" TextColor="{StaticResource TextPrimary}" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Recorded"    Style="{StaticResource UnitLabel}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAlert.aTimestampFull}"
                           FontSize="13" TextColor="{StaticResource TextPrimary}" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Recieved"    Style="{StaticResource UnitLabel}" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAlert.rTimestampFull}" FontSize="13" TextColor="{StaticResource TextPrimary}" />
                </Grid>

                <!-- Status flags -->
                <HorizontalStackLayout Spacing="10">
                    <Label Text="✓ Saved"
                           FontSize="12" TextColor="{StaticResource Green}"
                           IsVisible="{Binding SelectedAlert.IsSaved}" />
                    <Label Text="Dismissed"
                           FontSize="12" FontAttributes="Italic"
                           TextColor="{StaticResource TextMuted}"
                           IsVisible="{Binding SelectedAlert.IsDismissed}" />
                </HorizontalStackLayout>

                <!-- Modal action buttons -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

                    <!-- Save to log -->
                    <Button Grid.Column="0"
                            Text="Save to Log"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="40" Padding="0"
                            Command="{Binding ModalSaveCommand}"
                            IsEnabled="{Binding SelectedAlert.IsSaved, Converter={StaticResource InverseBool}}" />

                    <!-- Dismiss (clear badge, keep in panel) -->
                    <Button Grid.Column="1"
                            Text="Dismiss"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="40" Padding="0"
                            Command="{Binding ModalDismissCommand}"
                            IsEnabled="{Binding SelectedAlert.IsActive}" />

                    <!-- Clear (remove from panel) -->
                    <Button Grid.Column="2"
                            Text="Clear"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="40" Padding="0"
                            TextColor="{StaticResource Red}"
                            BorderColor="{StaticResource Red}"
                            Command="{Binding ModalClearCommand}" />
                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentView>
