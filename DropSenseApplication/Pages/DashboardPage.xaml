<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DropSense.Views"
    x:Class="DropSense.Views.DashboardPage">

    <Grid ColumnDefinitions="220,1,*">

        <!-- Sidebar (no VM dependency in XAML) -->
        <views:SidebarView Grid.Column="0" />

        <!-- Divider -->
        <BoxView Grid.Column="1"
             WidthRequest="1"
             BackgroundColor="{StaticResource Border}" />

        <!-- Main dashboard content -->
        <views:DashboardView Grid.Column="2" />

    </Grid>

</ContentPage>