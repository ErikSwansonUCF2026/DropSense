<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Views/PlantLibraryPage.xaml                                   -->
<!-- Mirrors SettingsPage exactly:                                              -->
<!--   Col 0 (260 px) — SidebarView                                            -->
<!--   Col 1 (1 px)   — vertical divider                                       -->
<!--   Col 2 (*)      — Row 0: header bar   |  Row 1: PlantLibraryView         -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:DropSense.Views" x:Class="DropSense.Views.PlantLibraryPage" Title="Plant Library" Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="260,1,*" RowDefinitions="Auto,*">

        <!-- ── Sidebar ────────────────────────────────────────────────── -->
        <views:SidebarView Grid.Column="0" Grid.RowSpan="2" />

        <!-- ── Vertical Divider ──────────────────────────────────────── -->
        <BoxView Grid.Column="1" Grid.RowSpan="2" WidthRequest="1" BackgroundColor="{StaticResource Border}" />

        <!-- ── Header Bar ─────────────────────────────────────────────── -->
        <Border Grid.Column="2" Grid.Row="0" ZIndex="10" BackgroundColor="{StaticResource White}" StrokeThickness="0" Padding="16,12">

            <Border.Shadow>
                <Shadow Brush="{StaticResource TextPrimary}" Offset="0,1" Radius="4" Opacity="0.4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="2">
                <Label Text="Plant Library" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BlueDark}" />
                <Label Text="Define plants and their sensor thresholds for alert evaluation" FontSize="12" TextColor="{StaticResource TextPrimary}" />
            </VerticalStackLayout>
        </Border>

        <!-- ── Plant Library Content ─────────────────────────────────── -->
        <views:PlantLibraryView Grid.Column="2" Grid.Row="1" />

    </Grid>

</ContentPage>
