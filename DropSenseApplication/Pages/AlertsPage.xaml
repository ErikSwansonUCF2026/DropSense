<?xml version="1.0" encoding="utf-8" ?>
<!-- DropSense — Pages/AlertsPage.xaml                                         -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->
<!-- Routable Shell page. Thin host for AlertsPanel.                          -->
<!-- Route: Routing.RegisterRoute(nameof(AlertsPage), typeof(AlertsPage));    -->
<!-- ══════════════════════════════════════════════════════════════════════════ -->

<views:ResponsiveShellPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:views="clr-namespace:DropSense.Views" 
             x:Class="DropSense.Views.AlertsPage" Title="Received Alerts" Shell.NavBarIsVisible="False">

    <Grid>

        <!-- ── Tablet + Desktop ──────────────────────────────────── -->
        <Grid x:Name="SidebarLayout" ColumnDefinitions="260,1,*" RowDefinitions="Auto,*">

            <views:SidebarView x:Name="DesktopSidebar" Grid.Column="0" Grid.RowSpan="2" WidthRequest="260" />
            <BoxView Grid.Column="1" Grid.RowSpan="2" WidthRequest="1" BackgroundColor="{StaticResource Border}" />

            <Border Grid.Column="2" Grid.Row="0" BackgroundColor="{StaticResource White}" StrokeThickness="0" Padding="16,12">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource TextPrimary}" Offset="0,1" Radius="4" Opacity="0.4" />
                </Border.Shadow>
                <VerticalStackLayout>
                    <Label Text="Alerts" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource BlueDark}" />
                    <Label Text="Received alerts information, and panel level controls" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <views:AlertsPanel Grid.Column="2" Grid.Row="1" />
        </Grid>

        <!-- ── Phone (slide-over sidebar) ────────────────────────── -->
        <Grid x:Name="MobileLayoutRoot" IsVisible="False">

            <Grid RowDefinitions="Auto,*">
                <Border BackgroundColor="{StaticResource White}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <ImageButton Source="menu.png" Clicked="MenuButton_Clicked" WidthRequest="32" HeightRequest="32" />
                        <Label Grid.Column="1" Text="Alerts" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <views:AlertsPanel Grid.Row="1" />
            </Grid>

            <BoxView x:Name="Overlay" Color="#80000000" Opacity="0" IsVisible="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OverlayTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <views:SidebarView x:Name="MobileSidebar" WidthRequest="260" TranslationX="-260" HorizontalOptions="Start" />

        </Grid>

    </Grid>

</views:ResponsiveShellPage>