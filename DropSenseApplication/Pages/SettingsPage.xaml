<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DropSense.Views"
    x:Class="DropSense.Views.SettingsPage"
    Title="Device Settings"
    Shell.NavBarIsVisible="False">

    <!-- ── Main Layout ───────────────────────────────────────────── -->
    <Grid ColumnDefinitions="260,1,*"
          RowDefinitions="Auto,*">

        <!-- ── Sidebar ───────────────────────────────────────────── -->
        <views:SidebarView
            Grid.Column="0"
            Grid.RowSpan="2" />

        <!-- ── Vertical Divider ─────────────────────────────────── -->
        <BoxView
            Grid.Column="1"
            Grid.RowSpan="2"
            WidthRequest="1"
            BackgroundColor="{StaticResource Border}" />

        <!-- ── Header Bar ────────────────────────────────────────── -->
        <Border
            Grid.Column="2"
            Grid.Row="0"
            ZIndex="10"
            BackgroundColor="{AppThemeBinding {StaticResource White}}"
            StrokeThickness="0"
            Padding="16,12">

            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark=Black}"
                        Offset="0,1"
                        Radius="4"
                        Opacity="0.4" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="2">

                <Label
                    Text="Device Settings"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource BlueDark},
                                                        Dark={StaticResource Gray100}}" />

                <Label
                    Text="Configure measurement and alert parameters"
                    FontSize="12"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary},
                                                        Dark={StaticResource Gray400}}" />

            </VerticalStackLayout>
        </Border>

        <!-- ── Main Settings Content ─────────────────────────────── -->
        <views:SettingsView
            Grid.Column="2"
            Grid.Row="1" />

    </Grid>

</ContentPage>